# Modos: mock | openrouter | local
AI_EXECUTION_MODE=mock
PORT=3000
AI_TIMEOUT_MS=15000
# Solo requerido en modo openrouter; NUNCA se publica en Git.
OPENROUTER_API_KEY=
# Debe ser un ID explícito que termine en :free; comprobar vigencia con npm run models:list.
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Instalar Ollama y descargar un modelo antes de usar modo local.
AI_LOCAL_MODEL=qwen2.5:0.5b
